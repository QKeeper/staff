{
  "name": "staff-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter \"./frontend\" --filter \"./backend\" dev",
    "dev:frontend": "pnpm --filter ./frontend dev",
    "dev:backend": "pnpm --filter ./backend dev",
    "build": "pnpm -r build",
    "format": "prettier --write --cache --log-level warn .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "validate": "pnpm format && pnpm typecheck && pnpm build",
    "set-role": "pnpm --filter @staff/backend set-role"
  },
  "devDependencies": {
    "@prisma/config": "^7.10.0",
    "@types/node": "^24.13.3",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
